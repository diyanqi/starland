# 服务监听地址（容器内默认 :8080）
ADDR=:8080

# PostgreSQL 连接串
DATABASE_URL=postgres://island:island_dev_pw@localhost:5432/shiguang?sslmode=disable

# 本地上传目录（相对 backend 目录）
UPLOAD_DIR=./uploads

# 管理端令牌：留空则管理接口关闭；至少 8 位
ADMIN_TOKEN=please-change-me

# 单张图片大小上限（MB，1-50）
MAX_UPLOAD_MB=8

# 部署在 Nginx / CDN 之后时设为 true，才会信任 X-Forwarded-For
TRUST_PROXY=false
